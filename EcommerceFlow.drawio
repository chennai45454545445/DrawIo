        </mxCell>

        <mxCell id="a10" value="INSERT / UPDATE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="cart" target="cartdb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

