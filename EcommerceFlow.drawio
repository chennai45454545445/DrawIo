<mxfile host="app.diagrams.net" modified="2026-07-17T00:00:00.000Z" agent="Mozilla/5.0" version="24.7.17">
  <diagram id="complete-ecommerce-flow" name="Complete E-Commerce System Flow">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- TITLE -->
        <mxCell id="title" value="&lt;b&gt;MINI E-COMMERCE ORDER SYSTEM - COMPLETE SYSTEM FLOW&lt;/b&gt;"
          style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="800" height="40" as="geometry"/>
        </mxCell>

        <!-- USER -->
        <mxCell id="user" value="&lt;b&gt;USER&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Customer"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;"
          vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="180" height="90" as="geometry"/>
        </mxCell>

        <!-- SIGNUP -->
        <mxCell id="signup" value="&lt;b&gt;SIGN UP&lt;/b&gt;&lt;br&gt;Enter Name&lt;br&gt;Email&lt;br&gt;Password"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;"
          vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="210" height="130" as="geometry"/>
        </mxCell>

        <!-- LOGIN -->
        <mxCell id="login" value="&lt;b&gt;LOGIN&lt;/b&gt;&lt;br&gt;Enter Email &amp; Password&lt;br&gt;Validate Credentials"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;"
          vertex="1" parent="1">
          <mxGeometry x="300" y="300" width="210" height="130" as="geometry"/>
        </mxCell>

        <!-- AUTH -->
        <mxCell id="auth" value="&lt;b&gt;AUTHENTICATION SERVICE&lt;/b&gt;&lt;br&gt;&lt;hr&gt;PreparedStatement&lt;br&gt;Check User Credentials&lt;br&gt;Create Customer Account"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;"
          vertex="1" parent="1">
          <mxGeometry x="600" y="180" width="260" height="170" as="geometry"/>
        </mxCell>

        <!-- CUSTOMER DB -->
        <mxCell id="customerdb" value="&lt;b&gt;CUSTOMERS TABLE&lt;/b&gt;&lt;br&gt;&lt;hr&gt;customer_id (PK)&lt;br&gt;name&lt;br&gt;email&lt;br&gt;password"
          style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;"
          vertex="1" parent="1">
          <mxGeometry x="950" y="180" width="230" height="170" as="geometry"/>
        </mxCell>

        <!-- LOGIN SUCCESS -->
        <mxCell id="success" value="&lt;b&gt;LOGIN SUCCESSFUL&lt;/b&gt;&lt;br&gt;User enters E-Commerce System"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;"
          vertex="1" parent="1">
          <mxGeometry x="1250" y="210" width="250" height="110" as="geometry"/>
        </mxCell>

        <!-- PRODUCT PAGE -->
        <mxCell id="productscreen" value="&lt;b&gt;PRODUCT LISTING&lt;/b&gt;&lt;br&gt;&lt;hr&gt;View Products&lt;br&gt;Product Details&lt;br&gt;Price&lt;br&gt;Available Stock"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;"
          vertex="1" parent="1">
          <mxGeometry x="1550" y="180" width="250" height="170" as="geometry"/>
        </mxCell>

        <!-- PRODUCT DB -->
        <mxCell id="productdb" value="&lt;b&gt;PRODUCTS TABLE&lt;/b&gt;&lt;br&gt;&lt;hr&gt;product_id (PK)&lt;br&gt;name&lt;br&gt;description&lt;br&gt;price&lt;br&gt;stock_quantity"
          style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;"
          vertex="1" parent="1">
          <mxGeometry x="1550" y="430" width="250" height="180" as="geometry"/>
        </mxCell>

        <!-- CART -->
        <mxCell id="cart" value="&lt;b&gt;SHOPPING CART&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Add Product&lt;br&gt;Remove Product&lt;br&gt;Update Quantity&lt;br&gt;View Cart"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;"
          vertex="1" parent="1">
          <mxGeometry x="1250" y="500" width="250" height="170" as="geometry"/>
        </mxCell>

        <!-- CART DB -->
        <mxCell id="cartdb" value="&lt;b&gt;CART TABLE&lt;/b&gt;&lt;br&gt;&lt;hr&gt;cart_id (PK)&lt;br&gt;customer_id (FK)&lt;br&gt;product_id (FK)&lt;br&gt;quantity"
          style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;"
          vertex="1" parent="1">
          <mxGeometry x="950" y="500" width="230" height="170" as="geometry"/>
        </mxCell>

        <!-- CHECKOUT -->
        <mxCell id="checkout" value="&lt;b&gt;CHECKOUT&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Confirm Cart Items&lt;br&gt;Calculate Total Amount&lt;br&gt;Place Order"
