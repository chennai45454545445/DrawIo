        </mxCell>

        <mxCell id="a9" value="Add to Cart" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="productscreen" target="cart">
